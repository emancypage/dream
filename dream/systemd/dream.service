[Unit]
Description=dream nightly — ingest + distill + consolidate + Codex curation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Provider routing, transcript sources, storage and review mode come from
# ~/.config/dream/config.toml. Include common CLI install locations only for lookup.
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=%h/.local/bin/dream-metrics start
ExecStart=%h/.local/bin/dream-stage ingest -- %h/.local/bin/dream ingest
ExecStart=%h/.local/bin/dream-stage distill -- %h/.local/bin/dream distill --yes --limit 50
ExecStart=%h/.local/bin/dream-stage consolidate -- %h/.local/bin/dream consolidate
ExecStart=%h/.local/bin/dream-stage curation -- %h/.local/bin/dream suggestions curate-configured
ExecStartPost=%h/.local/bin/dream-metrics success
ExecStopPost=%h/.local/bin/dream-metrics finalize ${SERVICE_RESULT} ${EXIT_STATUS}
