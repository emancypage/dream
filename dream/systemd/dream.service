[Unit]
Description=Dream nightly memory and character pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Provider routing, transcript sources, storage and review mode come from
# ~/.config/dream/config.toml. Include common CLI install locations only for lookup.
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=%h/.local/bin/dream-metrics start
ExecStart=%h/.local/bin/dream-stage --continue-on-error ingest -- %h/.local/bin/dream ingest
ExecStart=%h/.local/bin/dream-stage --continue-on-error distill -- %h/.local/bin/dream distill --yes --limit 50
ExecStart=%h/.local/bin/dream-stage --continue-on-error consolidate -- %h/.local/bin/dream consolidate
ExecStart=%h/.local/bin/dream-stage --continue-on-error curation -- %h/.local/bin/dream suggestions curate-configured
ExecStart=%h/.local/bin/dream-stage --continue-on-error character_generate -- %h/.local/bin/dream character generate --source all --limit 10
ExecStart=%h/.local/bin/dream-stage --continue-on-error character_judge -- %h/.local/bin/dream character judge --limit 10
ExecStartPost=%h/.local/bin/dream-metrics success
ExecStopPost=%h/.local/bin/dream-metrics finalize ${SERVICE_RESULT} ${EXIT_STATUS}
